# Flask Configuration
SECRET_KEY=change-this-in-production-random-secret-key-32-chars
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Base URL for QR codes (use local IP like http://192.168.1.50:5000 when testing on mobile)
APP_BASE_URL=http://127.0.0.1:5000

# Initial Demo User Passwords (Loaded on first seed, never stored in plain source code)
ADMIN_DEFAULT_PASSWORD=Admin@12345
SUPERVISOR_DEFAULT_PASSWORD=Super@12345
WORKER_DEFAULT_PASSWORD=Worker@12345

# Database Path
DATABASE_PATH=data/streetlights.db

# Incident Rules Configuration
OVERDUE_HOURS_THRESHOLD=48
REPEATED_FAULT_DAYS=30
REPEATED_FAULT_COUNT_THRESHOLD=3
